{# The Defra header from the AI toolkit: logo, then the service name in
   large green text. The logo is decorative because the link text carries
   the department's name for screen readers. #}
<header class="defra-header">
  <div class="defra-header__inner">
    <div class="defra-header__brand-group">
      <img class="defra-header__logo" src="{{ getAssetPath('src/client/assets/images/defra-logo.svg') }}" alt="" role="presentation">
      <a href="{{ serviceUrl }}" class="defra-header__service-name"><span class="govuk-visually-hidden">Department for Environment, Food and Rural Affairs: </span>{{ serviceName }}</a>
    </div>
  </div>
</header>

{# Shown once a person has a route. Before that, the start page and the
   questions are the whole service, and links to empty pages would mislead. #}
{% if navigation.length %}
<nav class="defra-service-navigation" aria-label="Service navigation" data-module="defra-service-navigation">
  <div class="defra-service-navigation__inner">
    <button type="button" class="defra-service-navigation__toggle" aria-controls="service-navigation-list" aria-expanded="false" hidden>Menu</button>
    <ul class="defra-service-navigation__list" id="service-navigation-list">
      {% for item in navigation %}
      <li class="defra-service-navigation__item">
        <a class="defra-service-navigation__link" href="{{ item.href }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.text }}</a>
      </li>
      {% endfor %}
    </ul>
  </div>
</nav>
{% endif %}
