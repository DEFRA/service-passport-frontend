{% extends 'layouts/page.njk' %}

{% from "govuk/components/task-list/macro.njk" import govukTaskList %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">{{ service.name }}</span>
      <h1 class="govuk-heading-l">Your calendar</h1>
      <p class="govuk-body">Worked back from go-live on {{ state.about.goLive | formatDate("d MMMM yyyy") }}. <a class="govuk-link" href="/about-your-service/go-live">Change your go-live date</a>.</p>
      <p class="govuk-body">Today is {{ route.now | formatDate("d MMMM yyyy") }}.</p>

      {% set goLive = state.about.goLive %}
      {% include "partials/booking-warning.njk" %}

      {% for month in months %}
        <h2 class="govuk-heading-m app-task-list-heading">{{ month.heading }}</h2>
        {{ govukTaskList({ idPrefix: "plan-" + loop.index, items: month.items, classes: "app-task-list" }) }}
      {% endfor %}
    </div>
  </div>
{% endblock %}
