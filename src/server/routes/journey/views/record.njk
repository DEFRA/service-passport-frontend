{% extends 'layouts/page.njk' %}

{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% set backLink = { href: step.href, text: "Back to " + step.sentenceName } %}
{% set stamp = step.stamp %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">{{ step.name }}</span>

      {% if stamp.fromData %}
        <h1 class="govuk-heading-l">{{ heading }}</h1>
        {{ govukInsetText({ text: "This is an example. In the real service, this link opens the deployment in the CDP portal." }) }}
        {{ govukSummaryList({ rows: [
          { key: { text: "Version" }, value: { text: stamp.version } },
          { key: { text: "Deployed" }, value: { text: stamp.decidedOn | formatDate("d MMMM yyyy") } },
          { key: { text: "Environment" }, value: { text: "prod" } }
        ] }) }}
      {% elif stamp.before %}
        <h1 class="govuk-heading-l">{{ heading }}</h1>
        {{ govukInsetText({ text: "This is an example. In the real service, this link opens " + stamp.foundIn + "." }) }}
        {{ govukSummaryList({ rows: [
          { key: { text: "Decided by" }, value: { text: step.decidedByLabel } },
          { key: { text: "Date" }, value: { text: stamp.decidedOn | formatDate("d MMMM yyyy") } },
          { key: { text: "Found by AI in" }, value: { text: stamp.foundIn } }
        ] }) }}
      {% else %}
        <h1 class="govuk-heading-l">{{ heading }}</h1>
        {{ govukInsetText({ text: "This is an example. In the real service, this link opens the " + step.waitingFor + "'s own record of the decision. The passport links to it and does not copy it." }) }}
        {% set rows = [
          { key: { text: "Decision" }, value: { text: step.outcomes[stamp.status] if step.outcomes else ({ "approved": "Approved", "approved-with-conditions": "Approved with conditions", "not-approved": "Not approved" })[stamp.status] } },
          { key: { text: "Decided by" }, value: { text: step.decidedByLabel } },
          { key: { text: "Date" }, value: { text: stamp.decidedOn | formatDate("d MMMM yyyy") } }
        ] %}
        {% if stamp.reason %}
          {% set rows = (rows.push({ key: { text: "Reason" }, value: { text: stamp.reason } }), rows) %}
        {% endif %}
        {% if stamp.conditions.length %}
          {% set conditionsHtml %}
            <ul class="govuk-list govuk-list--bullet">
              {% for condition in step.conditions %}<li>{{ condition.text }}, {{ ("by " + (condition.dueDate | formatDate("d MMMM yyyy"))) if condition.dueDate else "before go-live" }}</li>{% endfor %}
            </ul>
          {% endset %}
          {% set rows = (rows.push({ key: { text: "Conditions" }, value: { html: conditionsHtml } }), rows) %}
        {% endif %}
        {{ govukSummaryList({ rows: rows }) }}
      {% endif %}

      <p class="govuk-body"><a class="govuk-link" href="{{ step.href }}">Back to {{ step.sentenceName }}</a></p>
    </div>
  </div>
{% endblock %}
