{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% if not state.confirmed %}
  {% set backLink = { href: "/about-your-service/go-live" } %}
{% endif %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorList.length %}
        {{ govukErrorSummary({ titleText: "There is a problem", errorList: errorList }) }}
      {% endif %}

      {% include "partials/banner.njk" %}

      <span class="govuk-caption-l">{{ service.name }}</span>
      {% if state.confirmed %}
        <h1 class="govuk-heading-l">About your service</h1>
        <p class="govuk-body">Your route is built from these answers. Change one and your route changes with it.</p>
      {% else %}
        <h1 class="govuk-heading-l">Check your answers</h1>
        <p class="govuk-body">Your route is built from these answers. Change anything that is wrong.</p>
      {% endif %}

      {% set serviceRow = {
        key: { text: "Service on CDP" },
        value: { html: (service.name | escape) + '<span class="app-suggested">' + (service.id | escape) + '</span>' }
      } %}
      {% if not state.confirmed %}
        {% set serviceRow = { key: serviceRow.key, value: serviceRow.value, actions: { items: [{ href: "/about-your-service", text: "Change", visuallyHiddenText: "service on CDP" }] } } %}
      {% endif %}
      {{ govukSummaryList({
        rows: [
          serviceRow,
          {
            key: { text: "What it does" },
            value: { html: (service.summary | escape) + '<span class="app-suggested">From your README</span>' }
          },
          {
            key: { text: "Phase" },
            value: { html: (service.phase | escape) + ', moving to public beta' }
          },
          {
            key: { text: "Target go-live date" },
            value: { html: (state.about.goLive | formatDate("d MMMM yyyy")) + '<span class="app-suggested">When the service moves to public beta</span>' },
            actions: { items: [{ href: "/about-your-service/go-live", text: "Change", visuallyHiddenText: "target go-live date" }] }
          }
        ]
      }) }}
      {% if state.confirmed %}
        <p class="govuk-body">To set up a passport for a different service, <a class="govuk-link" href="/">start again</a>.</p>
      {% endif %}

      <h2 class="govuk-heading-m">{{ "What your route is built from" if state.confirmed else "Suggested by AI" }}</h2>
      {% set answerRows = [] %}
      {% for row in rows %}
        {% set valueHtml %}{% if row.lines and row.lines.length %}{% for line in row.lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}{% else %}{{ row.value }}{% endif %}<span class="app-suggested">{{ row.note }}</span>{% endset %}
        {% set answerRows = (answerRows.push({
          key: { text: row.label },
          value: { html: valueHtml },
          actions: { items: [{ href: "/about-your-service/" + row.id, text: "Change" if row.answered else "Answer", visuallyHiddenText: row.changeText, attributes: { id: "change-" + row.id } }] }
        }), answerRows) %}
      {% endfor %}
      {{ govukSummaryList({ rows: answerRows }) }}

      {% if state.confirmed %}
        {{ govukButton({ text: "Go to your passport", href: "/passport" }) }}
      {% else %}
        {% include "partials/ask-warning.njk" %}
        <form method="post" novalidate>
          <input type="hidden" name="crumb" value="{{ crumb }}">
          {{ govukButton({ text: "Confirm and set up your passport" }) }}
        </form>
      {% endif %}
    </div>
  </div>
{% endblock %}
