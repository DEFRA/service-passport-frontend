{% extends 'layouts/page.njk' %}

{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">Example guidance</span>
      <h1 class="govuk-heading-l">{{ step.source.text }}</h1>
      {{ govukInsetText({ text: "This is an example. In the real service, this link opens the guidance itself, and AI answers only from what it says." }) }}

      {% for paragraph in step.guidance %}
        <p class="govuk-body">{{ paragraph }}</p>
      {% endfor %}

      {% for answer in step.answers %}
        <h2 class="govuk-heading-m">{{ answer.example }}</h2>
        {% for paragraph in answer.paragraphs %}
          <p class="govuk-body">{{ paragraph }}</p>
        {% endfor %}
        {% if answer.bullets %}
          <ul class="govuk-list govuk-list--bullet">
            {% for bullet in answer.bullets %}<li>{{ bullet }}</li>{% endfor %}
          </ul>
        {% endif %}
      {% endfor %}

      <p class="govuk-body"><a class="govuk-link" href="/passport/{{ step.id }}">Back to {{ step.name }}</a></p>
    </div>
  </div>
{% endblock %}
