{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% set backLink = { href: "/passport", text: "Back to passport" } %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">{{ service.name }}</span>
      <h1 class="govuk-heading-l">Share your passport</h1>
      <p class="govuk-body">Send this link to anyone who needs to see where your service is up to, such as your project board at stage gate 4 or the change advisory board before release.</p>
      <p class="govuk-body">They will see every step, each decision, its date and a link to the evidence. Only the delivery lead and product lead for this service can change it.</p>

      {{ govukInput({
        id: "link",
        name: "link",
        label: { text: "Link to your passport", classes: "govuk-label--s" },
        value: link,
        readonly: true,
        spellcheck: false
      }) }}

      {{ govukInsetText({ text: "In the real service, people sign in with their Defra account to open the link. In this prototype the link only works in your own browser." }) }}

      {{ govukButton({ text: "Back to your passport", href: "/passport", classes: "govuk-button--secondary" }) }}
    </div>
  </div>
{% endblock %}
