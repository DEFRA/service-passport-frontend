{% extends 'layouts/page.njk' %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}

{% block beforeContent %}
  {{ govukBackLink({ text: "Back", href: backHref }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">{{ service.name if service else "Describe your service" }}</span>
      <h1 class="govuk-heading-l">Check your answers</h1>

      {{ govukSummaryList({ rows: rows }) }}

      <p class="govuk-body">The route is built from these answers. Change them again when the service changes.</p>

      <form method="post" action="{{ action }}" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">
        {{ govukButton({ text: "Build the route" if not service else "Update the route" }) }}
      </form>
    </div>
  </div>
{% endblock %}
