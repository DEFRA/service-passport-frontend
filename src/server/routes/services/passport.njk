{% extends 'layouts/page.njk' %}

{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/task-list/macro.njk" import govukTaskList %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% block content %}
  {% if updated %}
    {{ govukNotificationBanner({
      type: "success",
      text: "Route updated"
    }) }}
  {% endif %}

  <span class="govuk-caption-xl">Passport</span>
  <h1 class="govuk-heading-xl">{{ service.name }}</h1>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if route.next %}
        {{ govukWarningText({
          text: "Next: " + (route.next.name | lower) + ". " + route.next.wait + ".",
          iconFallbackText: "Warning"
        }) }}
      {% elif route.isLive %}
        {{ govukInsetText({ text: "This service is live. " + route.remaining.length + " closing steps left." }) }}
      {% endif %}

      {{ govukSummaryList({
        classes: "govuk-summary-list--no-border",
        rows: [
          { key: { text: "Phase" }, value: { text: phaseText } },
          { key: { text: "Gate" }, value: { text: gateText } },
          { key: { text: "Go-live" }, value: { text: goLiveText + (" (" + route.daysLeft + " days)" if route.daysLeft >= 0 else "") } },
          { key: { text: "Steps done" }, value: { text: route.doneCount + " of " + route.totalCount } },
          { key: { text: "Service Design Pack" }, value: { html: '<a class="govuk-link" href="/services/' + service.id + '/service-design-pack">' + pack.doneCount + ' of ' + pack.totalCount + ' items ready for gate 4</a>' } }
        ]
      }) }}

      <h2 class="govuk-heading-l">What is left before go-live</h2>

      {% for phase in remainingPhases %}
        <h3 class="govuk-heading-m">{{ phase.name }}</h3>
        {% set items = [] %}
        {% for step in phase.steps %}
          {% set hint = step.owner + ". " + step.wait + "." %}
          {% if step.journey %}
            {% set hint = step.journey.name + ". " + hint %}
          {% endif %}
          {% set items = (items.push({
            title: { text: step.name },
            hint: { text: hint },
            href: step.href,
            status: { tag: { text: ("Book now" if step.atRisk else step.tag.text), classes: ("govuk-tag--red" if step.atRisk else step.tag.classes) } }
          }), items) %}
        {% endfor %}
        {{ govukTaskList({ idPrefix: phase.id, items: items }) }}
      {% endfor %}

      {% if not remainingPhases.length %}
        <p class="govuk-body">Every step is done.</p>
      {% endif %}
    </div>

    <div class="govuk-grid-column-one-third">
      <h2 class="govuk-heading-s">About this service</h2>
      <p class="govuk-body">{{ service.description }}</p>
      <ul class="govuk-list">
        <li><a class="govuk-link" href="/services/{{ service.id }}/route">See the whole route</a></li>
        <li><a class="govuk-link" href="/services/{{ service.id }}/service-design-pack">Service Design Pack</a></li>
        <li><a class="govuk-link" href="/services/{{ service.id }}/describe">Change how the service is described</a></li>
      </ul>
      {% if service.journeys.length %}
        <h2 class="govuk-heading-s">Journeys</h2>
        <ul class="govuk-list">
          {% for journey in service.journeys %}
            <li>{{ journey.name }}<br><span class="govuk-hint govuk-!-margin-bottom-0">{{ journey.supplier }}</span></li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
{% endblock %}
