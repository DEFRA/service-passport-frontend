{% extends 'layouts/page.njk' %}

{% from "govuk/components/task-list/macro.njk" import govukTaskList %}

{% block content %}
  <span class="govuk-caption-xl">{{ service.name }}</span>
  <h1 class="govuk-heading-xl">Service Design Pack</h1>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <p class="govuk-body-l">
        {{ pack.doneCount }} of {{ pack.totalCount }} items ready for gate 4.
        Each item links to where its evidence lives. The pack never stores the documents.
      </p>

      {% for group in pack.groups %}
        <h2 class="govuk-heading-m">{{ group.name }}</h2>
        {% set items = [] %}
        {% for item in group.items %}
          {% set items = (items.push({
            title: { text: item.name },
            hint: { text: item.owner + ("." if not item.noFormalProcess else ". No formal process exists yet.") },
            href: item.href,
            status: { tag: item.tag }
          }), items) %}
        {% endfor %}
        {{ govukTaskList({ idPrefix: group.id, items: items }) }}
      {% endfor %}
    </div>
  </div>
{% endblock %}
